# Public URL of the deployed site (used for canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://unlockedsat.uz
# Sub-path when served from a folder, e.g. /unlocked on GitHub Pages ("" for a custom domain)
NEXT_PUBLIC_BASE_PATH=

# PostgreSQL via Supabase (see docs/DATABASE.md). Leave empty to use the built-in questions only.
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key (public by design). Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
