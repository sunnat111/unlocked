// Generates supabase/seed.sql from the built-in question bank. Run: npm run db:seed
import { writeFileSync } from 'node:fs';
import { questions } from '../src/data/questions.ts';

const q = (s: string | null | undefined) => (s == null ? 'null' : `'${s.replace(/'/g, "''")}'`);
const rows = questions.map((x) => {
  const choices = x.choices ? q(JSON.stringify(x.choices)) + '::jsonb' : 'null';
  const answer = x.choices ? String(x.answer) : 'null';
  const accept = x.accept ? `array[${x.accept.join(', ')}]::numeric[]` : 'null';
  return `  (${q(x.id)}, ${q(x.section)}, ${q(x.skill)}, ${x.difficulty}, ${q(x.passage)}, ${q(x.prompt)}, ${choices}, ${answer}, ${accept}, ${q(x.explanation)}, 'published')`;
});

const sql = `-- Unlocked SAT — starter question bank (${questions.length} original questions).
-- Generated by scripts/gen-seed.mts. Run after schema.sql in Supabase → SQL Editor.
-- Existing rows with the same id are left untouched, so it is safe to re-run.

insert into public.questions (id, section, skill, difficulty, passage, prompt, choices, answer, accept, explanation, status)
values
${rows.join(',\n')}
on conflict (id) do nothing;
`;
writeFileSync(new URL('../supabase/seed.sql', import.meta.url), sql);
console.log(`wrote supabase/seed.sql (${questions.length} questions)`);
